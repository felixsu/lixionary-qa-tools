# Backend configuration. docker-compose reads this file to substitute the
# values in its `environment:` block — that block is the only channel into the
# container, so a variable added here also needs adding there to have any
# effect. Frontend (NEXT_PUBLIC_*) settings live in frontend/.env.local.

GEMINI_API_KEY=YOUR_GEMINI_KEY

# Signs session tokens. Keep it STABLE across deploys — changing it
# invalidates every token already issued, which surfaces to users as
# "Invalid token signature" until they sign in again.
JWT_SECRET=random_32_characters

# Optional, defaults to 30. How long a session can renew silently before
# requiring a fresh sign-in.
REFRESH_TOKEN_EXPIRY_DAYS=30

GOOGLE_CLIENT_ID=YOUR_CLIENT_ID
GOOGLE_CLIENT_SECRET=GOCSPX-YOUR_CLIENT_SECRET

# MUST be set to false in any real deployment: it gates /dev-login, which mints
# a session for any email and role without going through Google.
DEV_MODE=true
