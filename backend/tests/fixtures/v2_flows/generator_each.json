{
  "name": "generator_each",
  "description": "The same Generator block with `each` connected produces a fresh value per driving item — a unique email per order. Three items in, three distinct emails out, paired positionally with the stream that drove them.",
  "collections": [
    {
      "id": "col",
      "requests": [
        { "id": "SIGNUP", "method": "POST", "url": "http://test/signup", "headers": [], "queryParams": [], "bodyType": "json", "body": "{\"email\": \"{{email}}\", \"seat\": \"{{seat}}\"}", "authType": "none", "authConfig": {}, "inputs": [], "outputs": [] }
      ]
    }
  ],
  "flow": {
    "id": "flow",
    "name": "generator_each",
    "schemaVersion": 2,
    "nodes": [
      {
        "id": "seats", "name": "seats", "type": "arrayEmit", "position": { "x": 0, "y": 0 },
        "config": { "staticItems": { "type": "json", "value": "[\"1A\", \"1B\", \"1C\"]" } }
      },
      {
        "id": "gen", "name": "gen", "type": "generator", "position": { "x": 0, "y": 0 },
        "config": { "token": "$randomEmail:lixionary.test", "useEach": true }
      },
      { "id": "signup", "name": "signup", "type": "request", "position": { "x": 0, "y": 0 }, "config": { "requestId": "SIGNUP", "staticInputs": {} } }
    ],
    "edges": [
      { "id": "e1", "source": "seats", "target": "gen", "sourceHandle": "out:item", "targetHandle": "in:ctl:each" },
      { "id": "e2", "source": "seats", "target": "signup", "sourceHandle": "out:item", "targetHandle": "in:seat" },
      { "id": "e3", "source": "gen", "target": "signup", "sourceHandle": "out:value", "targetHandle": "in:email" }
    ]
  },
  "executorScript": {
    "SIGNUP": [
      { "status": 201, "statusText": "Created", "headers": {}, "body": null, "outputs": {}, "missingOutputs": [] },
      { "status": 201, "statusText": "Created", "headers": {}, "body": null, "outputs": {}, "missingOutputs": [] },
      { "status": 201, "statusText": "Created", "headers": {}, "body": null, "outputs": {}, "missingOutputs": [] }
    ]
  },
  "expected": {
    "status": "success",
    "recordsByNode": {
      "signup": [
        { "status": "success", "iteration": 0 },
        { "status": "success", "iteration": 1 },
        { "status": "success", "iteration": 2 }
      ]
    },
    "bindings": {
      "SIGNUP": [{ "seat": "1A" }, { "seat": "1B" }, { "seat": "1C" }]
    },
    "bindingPatterns": {
      "SIGNUP": [
        { "email": "^[a-z]+\\.[a-z]+\\d{1,3}@lixionary\\.test$" },
        { "email": "^[a-z]+\\.[a-z]+\\d{1,3}@lixionary\\.test$" },
        { "email": "^[a-z]+\\.[a-z]+\\d{1,3}@lixionary\\.test$" }
      ]
    },
    "distinctBindings": [
      { "request": "SIGNUP", "input": "email" }
    ],
    "nodeItemCounts": {
      "gen": { "ok": 3, "failed": 0, "skipped": 0 }
    }
  }
}
