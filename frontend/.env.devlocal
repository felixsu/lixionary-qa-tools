# Config for the "local" flavor: running the frontend from this source
# checkout, as opposed to either installed desktop app.
#
# Loaded explicitly (via dotenv-cli) by the dev:local npm script, mirroring how
# .env.devflavor is loaded by dev:devflavor. Every port is +20 vs prod, so this
# coexists with both the installed prod app (8481/8484/9222) and the installed
# Dev app (8491/8494/9232). The matching sidecar is backend/dev_sidecar.py.
#
# No secrets here — all values are either localhost or already public
# (the Google OAuth client ID is a public identifier, not a secret).

NEXT_PUBLIC_APP_FLAVOR=local

# Points at the local docker-compose backend, never the production VPS.
NEXT_PUBLIC_VPS_API_URL=http://localhost:8480

# Sidecar port is +20 vs prod (8484); see backend/dev_sidecar.py.
NEXT_PUBLIC_LOCAL_API_URL=http://localhost:8504

NEXT_PUBLIC_GOOGLE_CLIENT_ID=471959538569-q04u1ugg1bvkcf641npa1qo4mekknjvp.apps.googleusercontent.com

# Frontend port is +20 vs prod (8481) for the same reason as the sidecar port.
NEXT_PUBLIC_REDIRECT_URI=http://localhost:8501/callback
